{
  "extends": "./.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    ".nuxt/**/*.d.ts",
    "app/types/**/*.d.ts",
    "app/utils/pengolo*.ts",
    "app/stores/usePengolo*.ts",
    "app/plugins/pengolo.client.ts",
    "app/components/Ai/**/*.vue",
    "app/components/Utils/Button.vue",
    "app/components/Utils/Modal.vue",
    "app/pages/pengolo/**/*.vue",
    "app/components/Administration/**/*.vue",
    "app/pages/settings/sso.vue",
    "app/composables/useAccount.ts",
    "app/composables/useCommandPaletteSearch.ts",
    "app/composables/useCommandPaletteHistory.ts",
    "app/composables/useCommandBar.ts",
    "app/components/Utils/CommandBar.vue"
  ],
  "exclude": ["node_modules", ".output"]
}
