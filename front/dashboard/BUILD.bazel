load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "//build:node.bzl",
    "define_nuxt_oci_image",
)

package(
    default_visibility = ["//visibility:public"],
)

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "runtime_layer",
    srcs = [":image_layer"],
)

js_test(
    name = "auth_test",
    data = glob(
        ["server/**/*.mjs", "server/**/*.ts", "app/utils/*.mjs"],
        allow_empty = True,
    ) + [
        "app/pages/login.vue",
        "app/pages/settings/sso.vue",
        "app/components/Navbar/Top.vue",
        "app/components/Onboarding/Tooltip.vue",
        "tests/passkey.test.mjs",
        "tests/admin.test.mjs",
        "tests/boundaries.test.mjs",
        "package.json",
        "nuxt.config.ts",
        ":node_modules/jose",
        ":node_modules/@simplewebauthn/server",
        ":node_modules/@opentelemetry/sdk-metrics",
        ":node_modules/@opentelemetry/resources",
    ],
    entry_point = "tests/auth.test.mjs",
)

exports_files([
    "apollo/default.ts",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".nuxt/**",
            ".output/**",
            "BUILD.bazel",
            "Dockerfile",
            "node_modules/**",
            "tests/**",
        ],
    ),
)

define_nuxt_oci_image(
    name = "image",
    srcs = [
        ":sources",
    ],
    base_amd64 = "@distroless_nodejs26_linux_amd64",
    base_arm64 = "@distroless_nodejs26_linux_arm64_v8",
    image_repository = "ghcr.io/aeluin-technologies/galadril-studio",
    image_title = "galadril-studio",
    source_repository = "https://github.com/aeluin-technologies/galadril",
    version_tags = "//:stamped_tags",
)
