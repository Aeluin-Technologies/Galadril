load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "//build:node.bzl",
    "define_nuxt_oci_image",
)

package(
    default_visibility = ["//visibility:public"],
)

npm_link_all_packages(name = "node_modules")

js_test(
    name = "email_test",
    copy_data_to_bin = False,
    data = ["app/utils/email.ts", "app/utils/email-thread.ts", "shared/text.ts"],
    entry_point = "tests/email.test.ts",
)

js_test(
    name = "pipeline_test",
    copy_data_to_bin = False,
    data = [
        "app/utils/pipeline.ts",
        "app/utils/plugin-blocks.ts",
    ],
    entry_point = "tests/pipeline.test.ts",
)

js_test(
    name = "pipeline_browser_test",
    size = "large",
    timeout = "long",
    chdir = "front/dashboard",
    data = [
        "tests/email-ui.spec.ts",
        "tests/email-profile.spec.ts",
        "tests/library-ui.spec.ts",
        "tests/pipeline-ui.spec.ts",
        "tests/playwright-pipeline.config.ts",
        ":ui_sources",
        "//front:testing_support",
    ],
    entry_point = "tests/run-pipeline-ui.ts",
    include_types = True,
    tags = [
        "local",
        "no-sandbox",
    ],
)


js_test(
    name = "pipeline_dev_browser_test",
    size = "large",
