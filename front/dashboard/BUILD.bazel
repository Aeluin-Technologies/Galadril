        "tests/session.test.ts",
        "tests/support.ts",
        "tests/nitro-fixture.ts",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/sdk-metrics",
        ":node_modules/@simplewebauthn/server",
        ":node_modules/h3",
        ":node_modules/jose",
    ],
    entry_point = "tests/auth.test.ts",
)

exports_files([
    "apollo/default.ts",
    "package.json",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".nuxt/**",
            ".output/**",
            ".pnpm-store/**",
            "BUILD.bazel",
            "Dockerfile",
            "node_modules/**",
            "tests/**",
        ],
    ),
)

define_nuxt_oci_image(
    name = "image",
    srcs = [
        ":sources",
        "//front:workspace_sources",
        "//front/ui:sources",
    ],
    base_amd64 = "@distroless_nodejs26_linux_amd64",
    base_arm64 = "@distroless_nodejs26_linux_arm64_v8",
    build_script = "build:checked",
    build_subdir = "dashboard",
    image_repository = "ghcr.io/aeluin-technologies/galadril-studio",
    image_title = "galadril-studio",
    source_repository = "https://github.com/aeluin-technologies/galadril",
    source_root = "front",
    version_tags = "//:stamped_tags",
)

js_test(
    name = "pengolo_activity_test",
    data = ["app/utils/pengolo-activity.ts", "tests/support.ts", "shared/text.ts"],
    entry_point = "tests/pengolo-activity.test.ts",
)

js_library(
    name = "ui_sources",
    srcs = [":sources"],
    data = [
        ":node_modules",
        "//front/ui:node_modules",
        "//front/ui:application_sources",
    ],
)

js_test(
    name = "localization_test",
    entry_point = "tests/localization.test.ts",
    data = [":ui_sources", ":node_modules/vue", ":node_modules/@intlify/message-compiler"],
)

[
    js_test(
        name = "ui_" + check + "_test",
        size = "large",
        timeout = "long",
        args = [check],
        chdir = "front/dashboard",
        # The runner materializes its own workspace; unit targets own their copied test files.
        copy_data_to_bin = False,
        data = glob(["tests/**"]) + [
            ":ui_sources",
            "//front:testing_support",
        ],
        entry_point = "tests/check-ui.ts",
        include_types = True,
        tags = [
            "local",
            "no-sandbox",
        ],
    )
    for check in [
        "typecheck",
        "tools",
        "lint",
        "format",
        "build",
    ]
]

js_test(
    name = "ui_browser_test",
    size = "large",
    timeout = "long",
    chdir = "front/dashboard",
    data = [
        "tests/dashboard-ui.spec.ts",
        "tests/playwright-ui.config.ts",
        ":ui_sources",
        "//front:testing_support",
    ],
    entry_point = "tests/run-ui.ts",
    include_types = True,
    tags = [
        "local",
        "no-sandbox",
    ],
)

js_test(
    name = "native_resolver_test",
    entry_point = "tests/native-resolver.test.ts",
    data = [":node_modules/@nuxt/eslint"],
)

js_test(
    name = "ui_server_test",
    copy_data_to_bin = False,
    entry_point = "tests/ui-server.test.ts",
    data = [
        "tests/playwright-ui.config.ts",
        ":node_modules/@playwright/test",
    ],
)

exports_files(["tests/email-profile.spec.ts"], visibility = ["//tests/e2e:__pkg__"])
