load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "//build:node.bzl",
    "define_nuxt_oci_image",
)

package(
    default_visibility = ["//visibility:public"],
)

npm_link_all_packages(name = "node_modules")

js_test(
    name = "pengolo_privacy_test",
    data = ["server/media/image.mjs"],
    entry_point = "tests/pengolo-privacy.test.mjs",
)

js_test(
    name = "pengolo_socket_test",
    data = ["app/utils/pengolo-socket.ts"],
    entry_point = "tests/pengolo-socket.test.ts",
)

js_test(
    name = "pengolo_markdown_test",
    data = [
        "app/utils/pengolo-export.ts",
        "app/utils/pengolo-markdown.ts",
        ":node_modules/@traptitech/markdown-it-katex",
        ":node_modules/exceljs",
        ":node_modules/highlight.js",
        ":node_modules/markdown-it",
        ":node_modules/markdown-it-footnote",
    ],
    entry_point = "tests/pengolo-markdown.test.ts",
)

js_test(
    name = "pengolo_test",
    data = ["app/utils/pengolo.ts"],
    entry_point = "tests/pengolo.test.ts",
)

js_test(
    name = "administration_test",
    data = glob(["app/utils/*.mjs"]),
    entry_point = "tests/admin.test.mjs",
)

filegroup(
    name = "pengolo_graphql_contract",
    srcs = ["app/graphql/pengolo.graphql"],
)

filegroup(
    name = "administration_graphql_contract",
    srcs = [
        "app/components/Administration/Permissions.vue",
        "app/pages/settings/sso.vue",
    ],
)

filegroup(
    name = "runtime_layer",
    srcs = [":image_layer"],
)

js_test(
    name = "auth_test",
    data = glob(
        [
            "server/**/*.mjs",
            "server/**/*.ts",
            "app/utils/*.mjs",
        ],
        allow_empty = True,
    ) + [
        "app/components/Navbar/Top.vue",
        "app/components/Onboarding/Tooltip.vue",
        "app/pages/login.vue",
        "app/pages/settings/sso.vue",
        "nuxt.config.ts",
        "package.json",
        "tests/admin.test.mjs",
        "tests/boundaries.test.mjs",
        "tests/passkey.test.mjs",
        "tests/restore.test.mjs",
        "tests/session.test.mjs",
        ":node_modules/@opentelemetry/resources",
        ":node_modules/@opentelemetry/sdk-metrics",
        ":node_modules/@simplewebauthn/server",
        ":node_modules/h3",
        ":node_modules/jose",
    ],
    entry_point = "tests/auth.test.mjs",
)

exports_files([
    "apollo/default.ts",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            ".nuxt/**",
            ".output/**",
            ".pnpm-store/**",
            "BUILD.bazel",
            "Dockerfile",
            "node_modules/**",
            "tests/**",
        ],
    ),
)

define_nuxt_oci_image(
    name = "image",
    srcs = [
        ":sources",
    ],
    base_amd64 = "@distroless_nodejs26_linux_amd64",
    base_arm64 = "@distroless_nodejs26_linux_arm64_v8",
    build_script = "build:checked",
    image_repository = "ghcr.io/aeluin-technologies/galadril-studio",
    image_title = "galadril-studio",
    source_repository = "https://github.com/aeluin-technologies/galadril",
    version_tags = "//:stamped_tags",
)
