filegroup(
    name = "runtime_layer",
    srcs = [":image_layer"],
)

js_test(
    name = "auth_test",
    data = glob(
        [
            "server/**/*.ts",
            "shared/**/*.ts",
            "app/utils/*.ts",
            "app/utils/*.json",
            "app/components/Authentication/*.vue",
            "app/components/Settings/*.vue",
        ],
        allow_empty = True,
    ) + [
        "app/components/Navbar/Account.vue",
        "app/components/Navbar/Top.vue",
        "app/components/Onboarding/Tooltip.vue",
        "app/pages/login.vue",
        "app/pages/settings/sso.vue",
        "app/pages/settings/user.vue",
        "nuxt.config.ts",
        "package.json",
        "tests/admin.test.ts",
        "tests/boundaries.test.ts",
        "tests/passkey.test.ts",
