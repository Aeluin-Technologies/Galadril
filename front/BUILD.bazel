load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

js_library(
    name = "testing_support",
    srcs = ["testing/stage.ts", "tsconfig.tools.json"],
    visibility = ["//front:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

exports_files([
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package.json",
]+glob(["patches/**"]))

filegroup(
    name = "workspace_sources",
    srcs = [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
    ] + glob(["patches/**"]),
    visibility = ["//front:__subpackages__"],
)

alias(
    name = "dashboard_image",
    actual = "//front/dashboard:image",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_amd64",
    actual = "//front/dashboard:image_amd64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_arm64",
    actual = "//front/dashboard:image_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_load_amd64",
    actual = "//front/dashboard:image_load_amd64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_load_arm64",
    actual = "//front/dashboard:image_load_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_push",
    actual = "//front/dashboard:image_push",
    visibility = ["//visibility:public"],
)
