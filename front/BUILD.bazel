load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")

js_library(
    name = "testing_support",
    srcs = [
        "testing/browser-profile.ts",
        "testing/browser-profile.test.ts",
        "testing/browser-test.ts",
        "testing/stage.ts",
        "testing/type-policy.ts",
        "tsconfig.tools.json",
    ],
    data = [":browser_coverage_dependencies"],
    visibility = ["//front:__subpackages__"],
)

npm_link_all_packages(name = "node_modules")

exports_files([
    "testing/browser-profile.ts",
    "testing/browser-test.ts",
], visibility = ["//tests/e2e:__pkg__"])

filegroup(
    name = "browser_coverage_dependencies",
    srcs = [
        ":node_modules/@jridgewell/trace-mapping",
        ":node_modules/@vitest/istanbul-lib-coverage",
        ":node_modules/@vitest/istanbul-lib-report",
        ":node_modules/@vue/compiler-sfc",
        ":node_modules/acorn",
        ":node_modules/ast-v8-to-istanbul",
    ],
)

exports_files([
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package.json",
]+glob(["patches/**"]))

filegroup(
    name = "workspace_sources",
    srcs = [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "testing/type-policy.ts",
    ] + glob(["patches/**"]),
    visibility = ["//front:__subpackages__"],
)

alias(
    name = "dashboard_image",
    actual = "//front/dashboard:image",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_amd64",
    actual = "//front/dashboard:image_amd64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_arm64",
    actual = "//front/dashboard:image_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_load_amd64",
    actual = "//front/dashboard:image_load_amd64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_load_arm64",
    actual = "//front/dashboard:image_load_arm64",
    visibility = ["//visibility:public"],
)

alias(
    name = "dashboard_image_push",
    actual = "//front/dashboard:image_push",
    visibility = ["//visibility:public"],
)

js_test(
    name = "typescript_tools_test",
    patch_node_fs = False,
    copy_data_to_bin = False,
    data = [
        "testing/external-eslint.config.ts",
        ":testing_support",
        "//front/ui:node_modules",
        "//infrastructure/envoy:typescript_quality_sources",
        "//tests/e2e:typescript_quality_sources",
    ],
    entry_point = "testing/external-quality.ts",
    include_types = True,
)

js_test(
    name = "browser_profile_test",
    data = [":testing_support"],
    entry_point = "testing/browser-profile.test.ts",
)
