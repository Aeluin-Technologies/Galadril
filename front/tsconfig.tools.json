{
  "extends": "./dashboard/.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "testing/**/*.ts",
    "ui/tests/**/*.ts",
    "dashboard/tests/**/*.ts",
    "dashboard/.nuxt/**/*.d.ts",
    "dashboard/app/types/**/*.d.ts",
    "dashboard/server/auth/**/*.ts",
    "dashboard/server/media/**/*.ts"
  ]
}
