{
  "name": "@galadril/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./tailwind": "./src/tailwind.ts",
    "./components": "./src/components.ts",
    "./nuxt": "./src/nuxt.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "nuxt dev playground --host 127.0.0.1 --port 3101",
    "build:playground": "nuxt build playground",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier src tests playground *.json --check"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@nuxt/kit": "4.6.2",
    "@opentelemetry/api": "^1.9.1",
    "reka-ui": "2.11.0"
  },
  "peerDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@heroicons/vue": "^2.2.0",
    "@nuxt/schema": "4.6.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vue/compiler-sfc": "3.5.44",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "nuxt": "^4.6.2",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin": "3.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "3.3.13"
  }
}
