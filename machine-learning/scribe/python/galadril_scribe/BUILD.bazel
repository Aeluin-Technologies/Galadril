# gazelle:ignore
# gazelle:ignore

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_image_layer", "py_layer_tier")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "galadril_scribe",
    srcs = glob(["*.py"]),
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//platform/ontology/src/galadril_ontology",
        "@pip//cryptography",
        "@pip//pyjwt",
        "@pip//openai",
        "//third_party/hipporag:official",
        "//machine-learning/eru/src/eru:documents",
        "//machine-learning/eru/src/eru/llm",
        "@pip//huggingface_hub",
        "//machine-learning/galadril-inference/src/galadril_inference/models/embedding:qwen",
        "//machine-learning/galadril-inference/src/galadril_inference/models:reranking",
        "//machine-learning/galadril-inference/src/galadril_inference/models:qwen_reranking",
        "@pip//pypdfium2",
        "@pip//pillow",
        "//machine-learning/galadril-inference/src/galadril_inference/models/text:glm_ocr_cpu",
        "//platform/pipeline/src/galadril_pipeline",
        "//machine-learning/scribe/python/galadril_sandbox:contracts",
        "@pip//fastapi",
        "@pip//httpx",
        "@pip//numpy",
        "@pip//matplotlib",
        "@pip//pydantic",
        "@pip//pydantic_settings",
        "@pip//pydantic_ai_slim",
        "@pip//pydantic_ai_harness",
        "@pip//pydantic_monty_client",
        "@pip//pydantic_monty_runtime",
        "@pip//structlog",
        "@pip//opentelemetry_api",
        "@pip//opentelemetry_sdk",
        "@pip//opentelemetry_exporter_otlp_proto_grpc",
        "@pip//uvicorn",
        "@pip//uvloop",
    ],
)

py_binary(
    name = "server",
    srcs = ["main.py"],
    main = "main.py",
    deps = [":galadril_scribe"],
    visibility = ["//visibility:public"],
)

py_layer_tier(
    name = "server_layer_tier",
    groups = {
        "@pip//torch:torch": "torch_cpu",
        "@pip//transformers:transformers": "transformers",
        "@pip//sympy:sympy": "sympy",
        "@pip//pandas:pandas": "pandas",
        "@pip//pyarrow:pyarrow": "pyarrow",
        "@pip//onnxruntime:onnxruntime": "onnxruntime",
        "@pip//numpy:numpy": "numpy",
        "@pip//llama_cpp_python:llama_cpp_python": "llama_cpp_python",
        "@pip//pydantic_monty_runtime:pydantic_monty_runtime": "pydantic_monty_runtime",
        "@pip//matplotlib:matplotlib": "matplotlib",
        "@pip//fonttools:fonttools": "fonttools",
        "@pip//pillow:pillow": "pillow",
        "@pip//uvloop:uvloop": "uvloop",
        "@pip//cryptography:cryptography": "cryptography",
        "@pip//grpcio:grpcio": "grpcio",
    },
    visibility = ["//tests/e2e/fixtures:__pkg__"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server",
    layer_tier = ":server_layer_tier",
)

oci_image(
    name = "linux",
    base = "@bristroless_python",
    entrypoint = ["/app"],
    env = {"PYTHONPATH": "/site-packages"},
    tars = [":server_layers"],
    visibility = ["//visibility:public"],
)

platform_transition_filegroup(
    name = "image_amd64",
    srcs = [":linux"],
    target_platform = "//:linux_amd64",
)

platform_transition_filegroup(
    name = "image_arm64",
    srcs = [":linux"],
    target_platform = "//:linux_arm64",
)

oci_image_index(
    name = "images",
    images = [":image_amd64", ":image_arm64"],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-scribe",
    visibility = ["//visibility:public"],
)
