load("//build:testing.bzl", "DOCKER_TEST_EXEC_PROPERTIES")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "gateway",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//schemas:postgres_migrations"],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//machine-learning/scribe",
        "//platform/telemetry",
        "//platform/versioning",
    ],
)

rust_test(
    name = "gateway_test",
    size = "large",
    compile_data = [
        "//schemas:postgres_gateway_schema",
        "//schemas/spicedb:cedar_contextual_constraints",
    ],
    crate = ":gateway",
    exec_properties = DOCKER_TEST_EXEC_PROPERTIES,
    tags = [
        "integration",
        "no-sandbox",
        "requires-docker",
    ],
    deps = all_crate_deps(normal_dev = True),
)

pkg_tar(
    name = "layer",
    srcs = [":gateway"],
)

oci_image(
    name = "linux",
    base = "@distroless_cc",
    entrypoint = ["/gateway"],
    tars = [":layer"],
)

oci_image_index(
    name = "images",
    images = [
        ":linux",
    ],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-gateway",
    visibility = ["//visibility:public"],
)
