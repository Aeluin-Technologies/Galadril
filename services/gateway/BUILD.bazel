load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:oci_test.bzl", "multiarch_index_test")
load("//build:testing.bzl", "DOCKER_TEST_EXEC_PROPERTIES")

rust_binary(
    name = "auth_fixture",
    testonly = True,
    srcs = [
        "src/authentication.rs",
        "tests/auth_server.rs",
    ] + glob(["src/authentication/*.rs"]),
    compile_data = ["//schemas/spicedb:spicedb_contract"],
    crate_root = "tests/auth_server.rs",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + ["//platform/telemetry"],
)

pkg_tar(
    name = "auth_fixture_layer",
    testonly = True,
    srcs = [":auth_fixture"],
)

platform_transition_filegroup(
    name = "auth_fixture_runtime",
    testonly = True,
    srcs = [":auth_fixture_layer"],
    target_platform = "//:linux_amd64",
    visibility = ["//infrastructure/auth/tests:__pkg__"],
)

rust_test(
    name = "sso_policy_test",
    srcs = ["src/domain/sso.rs"],
    crate_root = "src/domain/sso.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "general_access_policy_test",
    srcs = ["src/application/usecases/general_access.rs"],
    crate_root = "src/application/usecases/general_access.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:cedar-policy",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "federation_policy_test",
    srcs = ["src/authentication/federation.rs"],
    crate_root = "src/authentication/federation.rs",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "gateway",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "//schemas:postgres_migrations",
        "//platform/pipeline/src/galadril_pipeline:builtin_capabilities.json",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//platform/registry",
        "//platform/telemetry",
    ],
)

rust_test(
    name = "gateway_test",
    size = "large",
    compile_data = [
        "//platform/pipeline/src/galadril_pipeline:builtin_capabilities.json",
        "//front/dashboard:administration_graphql_contract",
        "//front/dashboard:pengolo_graphql_contract",
        "//schemas:postgres_gateway_schema",
        "//schemas/spicedb:cedar_contextual_constraints",
        "//schemas/spicedb:spicedb_contract",
        "//tests/e2e:administration_graphql_contract",
        "tests/fixtures/saml-metadata.xml",
    ],
    crate = ":gateway",
    exec_properties = DOCKER_TEST_EXEC_PROPERTIES,
    tags = [
        "integration",
        "no-sandbox",
        "requires-docker",
    ],
    deps = all_crate_deps(normal_dev = True),
)

pkg_tar(
    name = "layer",
    srcs = [":gateway"],
)

oci_image(
    name = "linux",
    base = "@distroless_cc",
    entrypoint = ["/gateway"],
    tars = [":layer"],
    visibility = ["//tests/e2e:__pkg__"],
)

platform_transition_filegroup(
    name = "image_amd64",
    srcs = [":linux"],
    target_platform = "//:linux_amd64",
)

platform_transition_filegroup(
    name = "image_arm64",
    srcs = [":linux"],
    target_platform = "//:linux_arm64",
)

oci_image_index(
    name = "images",
    images = [
        ":image_amd64",
        ":image_arm64",
    ],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-gateway",
    visibility = ["//visibility:public"],
)

multiarch_index_test(
    name = "multiarch_index_test",
    target_under_test = ":images",
)

rust_test(
    name = "capabilities_test",
    srcs = ["src/domain/capabilities.rs"],
    compile_data = ["//platform/pipeline/src/galadril_pipeline:builtin_capabilities.json"],
    crate_root = "src/domain/capabilities.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "agent_activity_test",
    srcs = ["src/domain/agent_activity.rs"],
    crate_root = "src/domain/agent_activity.rs",
    deps = [
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "interaction_policy_test",
    srcs = ["src/application/usecases/agent_interactions.rs"],
    crate_root = "src/application/usecases/agent_interactions.rs",
)
