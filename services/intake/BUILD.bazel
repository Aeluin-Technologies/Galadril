load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:oci_test.bzl", "multiarch_index_test")

rust_binary(
    name = "intake",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "//schemas:avro_schema",
    ],
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    rustc_env = {
        "CARGO_PKG_VERSION": "{STABLE_VERSION}",
    },
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//platform/registry",
        "//platform/telemetry",
    ],
)

rust_test(
    name = "intake_test",
    crate = ":intake",
    data = ["//schemas:avro_schema"],
    deps = all_crate_deps(normal_dev = True),
)

pkg_tar(
    name = "layer",
    srcs = [":intake"],
)

oci_image(
    name = "linux",
    base = "@distroless_cc",
    entrypoint = ["/intake"],
    tars = [":layer"],
    visibility = ["//tests/e2e:__pkg__"],
)

platform_transition_filegroup(
    name = "image_amd64",
    srcs = [":linux"],
    target_platform = "//:linux_amd64",
)

platform_transition_filegroup(
    name = "image_arm64",
    srcs = [":linux"],
    target_platform = "//:linux_arm64",
)

oci_image_index(
    name = "images",
    images = [
        ":image_amd64",
        ":image_arm64",
    ],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-intake",
    visibility = ["//visibility:public"],
)

multiarch_index_test(
    name = "multiarch_index_test",
    target_under_test = ":images",
)
