load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:oci_test.bzl", "multiarch_index_test")
load("//build:testing.bzl", "DOCKER_TEST_EXEC_PROPERTIES")

rust_binary(
    name = "registry",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//platform/registry",
        "//platform/telemetry",
    ],
)

rust_test(
    name = "registry_test",
    crate = ":registry",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "storage_grpc_test",
    size = "large",
    srcs = ["tests/storage_grpc.rs"],
    exec_properties = DOCKER_TEST_EXEC_PROPERTIES,
    tags = [
        "integration",
        "no-sandbox",
        "requires-docker",
    ],
    deps = ["//platform/registry"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

pkg_tar(
    name = "layer",
    srcs = [":registry"],
)

oci_image(
    name = "linux",
    base = "@distroless_cc",
    entrypoint = ["/registry"],
    tars = [":layer"],
    visibility = ["//tests/e2e:__pkg__"],
)

platform_transition_filegroup(
    name = "image_amd64",
    srcs = [":linux"],
    target_platform = "//:linux_amd64",
)

platform_transition_filegroup(
    name = "image_arm64",
    srcs = [":linux"],
    target_platform = "//:linux_arm64",
)

oci_image_index(
    name = "images",
    images = [":image_amd64", ":image_arm64"],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-registry",
    visibility = ["//visibility:public"],
)

multiarch_index_test(
    name = "multiarch_index_test",
    target_under_test = ":images",
)
