load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//build:testing.bzl", "DOCKER_TEST_EXEC_PROPERTIES")

# gazelle:ignore

py_library(
    name = "models",
    testonly = True,
    srcs = ["test_models.py"],
)

py_test(
    name = "collectors_test",
    size = "large",
    srcs = ["test_collectors.py"],
    data = [
        "//infrastructure/docker:compose",
        "//infrastructure/docker:compose_configuration",
        "//infrastructure/observability:collector_configuration",
    ],
    exec_properties = DOCKER_TEST_EXEC_PROPERTIES,
    legacy_create_init = False,
    main = "test_collectors.py",
    tags = [
        "integration",
        "no-sandbox",
        "requires-docker",
    ],
    deps = [
        ":models",
        "@pip//httpx",
        "@pip//testcontainers",
    ],
)

py_test(
    name = "test_models",
    srcs = ["test_models.py"],
    data = [
        "//infrastructure/docker:.env.example",
        "//infrastructure/docker:dev-environment.sh",
        "//infrastructure/docker:compose",
        "//infrastructure/docker:compose_configuration",
        "//tests/e2e:environment/compose.yaml",
    ],
    legacy_create_init = False,
    main = "test_models.py",
)

py_test(
    name = "test_compose",
    srcs = ["test_compose.py"],
    data = [
        "//front/dashboard:apollo/default.ts",
        "//infrastructure/docker:compose_configuration",
        "//infrastructure/observability:tempo.yaml",
    ],
    legacy_create_init = False,
    deps = ["@pip//pyyaml"],
)

py_test(
    name = "test_compiler_deployment",
    srcs = ["test_compiler_deployment.py"],
    data = [
        "//infrastructure/docker:compose_configuration",
        "//infrastructure/kubernetes-overlays:configuration",
    ],
    legacy_create_init = False,
    deps = ["@pip//pyyaml"],
)
