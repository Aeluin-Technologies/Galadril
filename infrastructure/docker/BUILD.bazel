load("@bazel_lib//lib:copy_file.bzl", "copy_file")

exports_files([
    "connectors.yaml",
    ".env.example",
])

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "macos_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

copy_file(
    name = "compose",
    src = select({
        ":linux_amd64": "@docker_compose_linux_amd64//file",
        ":linux_arm64": "@docker_compose_linux_arm64//file",
        ":macos_amd64": "@docker_compose_macos_amd64//file",
        ":macos_arm64": "@docker_compose_macos_arm64//file",
    }),
    out = "docker-compose",
    is_executable = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "database_initialization",
    srcs = [
        "init-scripts/01-init-spicedb.sh",
        "init-scripts/02-init-galadril-roles.sh",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "compose_configuration",
    srcs = glob([
        "*.yaml",
        "init-scripts/*.sh",
        "searxng/*.yml",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pipeline_e2e_configuration",
    srcs = [
        "auth.yaml",
        "broker.yaml",
        "dashboard.yaml",
        "database.yaml",
        "init-scripts/01-init-spicedb.sh",
        "init-scripts/02-init-galadril-roles.sh",
        "init-scripts/03-init-auth.sh",
        "local-auth.yaml",
        "mcp.yaml",
        "observability.yaml",
        "proxy.yaml",
        "s3-notifications.yaml",
        "s3.yaml",
        "streaming.yaml",
    ],
    visibility = ["//tests/e2e:__pkg__"],
)
