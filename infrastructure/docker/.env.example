# Development credentials. These must also match examples/pipeline.yaml.
# Use an external secret/configuration system outside a disposable local stack.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=galadril_dev
SPICEDB_GRPC_PRESHARED_KEY=secret_key

INTAKE_RUST_LOG=info

GATEWAY_PORT=8080
GRAFANA_PORT=3005
JAEGER_UI_PORT=16686
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDPANDA_CONSOLE_PORT=8090
REDPANDA_KAFKA_PORT=29092
STUDIO_PORT=3000
VISION_LOG_LEVEL=INFO
VISION_SHM_SIZE=1gb

# Leave empty for embedded local Ray. KubeRay uses ray://<head-service>:10001.
RAY_ADDRESS=
