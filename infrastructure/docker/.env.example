# Run uv run infrastructure/dev/galadril.py from the repository root.
# Runtime configuration is generated privately under .local/dev.
# It generates matching private identity, Compose and connector configuration.
# Use an external secret/configuration system outside a disposable local stack.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_USER=postgres
GALADRIL_APP_PASSWORD=galadril_app
GALADRIL_MAINTENANCE_PASSWORD=galadril_maintenance
POSTGRES_PASSWORD=postgres
POSTGRES_DB=galadril_dev
SPICEDB_GRPC_PRESHARED_KEY=secret_key

INTAKE_RUST_LOG=info

GATEWAY_PORT=8080
GRAFANA_PORT=3005
JAEGER_UI_PORT=16686
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDPANDA_CONSOLE_PORT=8090
REDPANDA_KAFKA_PORT=29092
STUDIO_PORT=3000
VISION_LOG_LEVEL=INFO
VISION_SHM_SIZE=1gb

# Leave empty for embedded local Ray. KubeRay uses ray://<head-service>:10001.
RAY_ADDRESS=

# Local password accounts are available only with the local-auth Compose profile.
AUTH_PUBLIC_ORIGIN=https://localhost:8080
AUTH_LOCAL_LOGIN_ENABLED=true

# The CLI supplies its generated .local/dev/compose.env explicitly.
COMPOSE_PROJECT_NAME=galadril-dev
COMPOSE_PROFILES=local-auth
LAKEFS_IMAGE=treeverse/lakefs:1.86.0
LAKEFS_PORT=8000
LAKEFS_ACCESS_KEY_ID=development-registry-access
LAKEFS_SECRET_ACCESS_KEY=development-registry-secret
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=development-only-lakefs-encryption-key
# Registry uses S3 directly only for tenant markers and GDPR purges.
# Production should use credentials restricted to the Registry namespace.

# Use an absolute path to a trusted connector file to override the example.
# GALADRIL_CONNECTORS_PATH=/etc/galadril/connectors.yaml

# Set application image tags built from the Registry-enabled revision.
# GALADRIL_REGISTRY_IMAGE=galadril-registry:local
# GALADRIL_GATEWAY_IMAGE=galadril-gateway:local
# GALADRIL_INTAKE_IMAGE=galadril-intake:local
# GALADRIL_VISION_IMAGE=galadril-vision:local

# The CLI selects infrastructure/dev/model-catalogs.json when an OpenAI key is supplied.
# Explicit SCRIBE_MODELS and SCRIBE_DEFAULT_MODEL settings override managed defaults.
# Local search has no OpenAI search-tool charge. Model inference is still billed.
SCRIBE_WEB_SEARCH_PROVIDER=gateway
PENGOLO_WEB_SEARCH_PROVIDER=searxng
PENGOLO_WEB_SEARCH_URL=http://searxng:8080/search

# Remote entity and relation extraction never downloads a local generative model.
SCRIBE_DOCUMENT_ERU_TIER=0.6b
SCRIBE_DOCUMENT_RERANKER=bge
SCRIBE_DOCUMENT_REMOTE_RELATIONS=true
SCRIBE_DOCUMENT_RELATION_MODEL=gpt-5.6-terra
# Optional existing OpenAI or vLLM alias overriding SCRIBE_DOCUMENT_RELATION_MODEL.
SCRIBE_DOCUMENT_EXTRACTION_MODEL=
# int8 changes the vector profile and requires rebuilding document revisions.
SCRIBE_DOCUMENT_EMBEDDING_COMPUTE_TYPE=bf16
SCRIBE_MEMORY_LIMIT=5g
SCRIBE_CPUS=3
SCRIBE_INFERENCE_THREADS=2

# Personal open-source installations only; the browser callback stays on loopback.
GALADRIL_CHATGPT_ENABLED=false
# Public recipient-reachable HTTPS origin; empty keeps email opening tracking off.
GALADRIL_UTILS_TRACKING_PUBLIC_URL=
GALADRIL_CHATGPT_CALLBACK_PORT=1455
SCRIBE_CHATGPT_ENCRYPTION_KEY=
# Optional named tunnel profile: --profile email-tracking. Keep this token file private.
# GALADRIL_UTILS_TUNNEL_TOKEN_FILE=../../.local/utils-email/cloudflare/token
# GALADRIL_UTILS_TRACKER_IMAGE=ghcr.io/aeluin-technologies/galadril-utils-email-tracker:<published-tag>
