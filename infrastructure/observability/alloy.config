discovery.docker "galadril" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "galadril_binaries" {
  targets = discovery.docker.galadril.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(gateway|intake|vision)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    replacement   = "galadril-$1"
    target_label  = "service_name"
  }

  rule {
    replacement  = "development"
    target_label = "deployment_environment"
  }
}

pyroscope.ebpf "galadril" {
  targets         = discovery.relabel.galadril_binaries.output
  forward_to      = [pyroscope.write.central.receiver]
  sample_rate     = 19
  collect_interval = "30s"
  kernel_frames   = false
  python_enabled  = true
  lazy_mode       = true
}

pyroscope.write "central" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
