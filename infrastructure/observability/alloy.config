discovery.docker "galadril" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "galadril_binaries" {
  targets = discovery.docker.galadril.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(gateway|intake|vision|studio|scribe|registry|document-compiler|utils-email|s3-notifications|rustfs|kratos|hydra|polis)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    replacement   = "galadril-$1"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?utils-email"
    replacement   = "galadril-plugin-utils-email"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?s3-notifications"
    replacement   = "s3-notifications"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?rustfs"
    replacement   = "rustfs"
    target_label  = "service_name"
  }

  rule {
    replacement  = "development"
    target_label = "deployment_environment"
  }
}

pyroscope.ebpf "galadril" {
  targets         = discovery.relabel.galadril_binaries.output
  forward_to      = [pyroscope.write.central.receiver]
  sample_rate     = 19
  off_cpu_threshold = 0.01
  collect_interval = "30s"
  kernel_frames   = false
  python_enabled  = true
  lazy_mode       = true
}

pyroscope.write "central" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
