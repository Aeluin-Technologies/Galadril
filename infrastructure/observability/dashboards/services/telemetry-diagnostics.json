      "type": "stat",
      "title": "CPU profiling sessions failed · 15m",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pyroscope_ebpf_profiling_sessions_failing_total[15m])) or vector(0)",
          "range": false
