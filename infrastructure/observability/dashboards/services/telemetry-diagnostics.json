{
  "uid": "galadril-telemetry-diagnostics",
  "id": null,
  "title": "Galadril / Telemetry Diagnostics",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "galadril",
    "debug",
    "traces",
    "profiles",
    "logs"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 5,
      "type": "stat",
      "title": "eBPF targets discovered",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pyroscope_ebpf_active_targets) or vector(0)",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "description": "Collector pipeline health from Alloy pyroscope.ebpf metrics scraped into Mimir."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "CPU profiling sessions started",
