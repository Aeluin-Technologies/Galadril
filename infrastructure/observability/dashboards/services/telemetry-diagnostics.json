    {
      "id": 8,
      "type": "stat",
      "title": "Profiles dropped",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pyroscope_ebpf_pprofs_dropped_total) or vector(0)",
          "range": false
