{
  "uid": "galadril-kafka-ray",
  "title": "Kafka & Ray",
  "description": "Kafka lag is calculated from broker offsets. Ray in-flight work includes queued and running calls.",
  "tags": [
    "galadril",
    "provisioned"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Kafka lag by consumer group",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (redpanda_group) (clamp_min(max by (redpanda_topic, redpanda_partition) (redpanda_kafka_max_offset{redpanda_namespace=\"kafka\"}) - on (redpanda_topic, redpanda_partition) group_right max by (redpanda_group, redpanda_topic, redpanda_partition) (redpanda_kafka_consumer_group_committed_offset), 0))",
          "legendFormat": "{{redpanda_group}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "title": "Kafka request volume",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(redpanda_kafka_request_bytes_total[$__rate_interval]))",
          "legendFormat": "Request bytes/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2
    },
    {
      "title": "In-flight Ray tasks by pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (galadril_vision_resource_class) (galadril_vision_task_active)",
          "legendFormat": "{{galadril_vision_resource_class}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3
    },
    {
      "title": "Ray task results by pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (galadril_vision_resource_class, galadril_vision_outcome) (rate(galadril_vision_task_completed_total[$__rate_interval]))",
          "legendFormat": "{{galadril_vision_resource_class}} {{galadril_vision_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ray nodes reporting",
      "description": "Counts healthy scraped Ray agents with a CPU-count datapoint. Compose includes the embedded node. A shared cluster requires its own scrape discovery.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (job, instance) (ray_node_cpu_count{job=\"ray\"} and on (job, instance) (up{job=\"ray\"} == 1))) or count(up{job=\"ray\"} == 1) * 0",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ray node CPU utilization",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ray_node_cpu_utilization{job=\"ray\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ray node memory used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ray_node_cgroup_mem_used{job=\"ray\"} or on (instance) ray_node_mem_used{job=\"ray\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ray node disk free",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ray_node_disk_free{job=\"ray\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
