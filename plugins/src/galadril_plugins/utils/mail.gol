        }
    }
}

ontology documents.attachments version "1.0.0" {
    security label InternalData {
        classification: Internal;
    }
    entity Attachment {
        field name: Option<String> @label(InternalData);
        field mime: Option<String> @label(InternalData);
        field source: Option<String> @label(InternalData);
    }
    entity Content {
    }
    relation AttachmentContent {
        role source: Attachment [1..1];
        role target: Content [0..*];
    }
    access Attachment {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
