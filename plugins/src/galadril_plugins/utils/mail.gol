// Authored GOL contract; security identities remain external.

ontology communication.people version "1.0.0" {
    security label InternalData {
        classification: Internal;
    }
    entity Person {
        field name: Option<String> @label(InternalData);
    }
    entity Address {
        field value: Option<String> @label(InternalData);
    }
    relation AddressPerson {
        role source: Address [1..1];
        role target: Person [0..*];
    }
    access Person {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access Address {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access AddressPerson {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
}

ontology communication.content version "1.0.0" {
    security label InternalData {
        classification: Internal;
    }
    entity Content {
        field text: Option<String> @label(InternalData);
        field html: Option<String> @label(InternalData);
    }
    entity Signature {
        field text: Option<String> @label(InternalData);
    }
    access Content {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access Signature {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
