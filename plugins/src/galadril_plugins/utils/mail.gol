ontology communication.mail version "1.0.0" {
    import communication.content version "1.0.0" as CommunicationContent;
    import communication.people version "1.0.0" as CommunicationPeople;
    import communication.threads version "1.0.0" as CommunicationThreads;
    import documents.attachments version "1.0.0" as DocumentsAttachments;
    import type gal.time::Instant version "1.0.0";
    security label InternalData {
        classification: Internal;
    }
    entity Message {
        field subject: Option<String> @label(InternalData);
        field id: Option<String> @label(InternalData);
        field date: Option<gal.time.Instant> @label(InternalData);
    }
    relation MessageSender {
        role source: Message [1..1];
        role target: communication.people.Person [0..*];
    }
    relation MessageTo {
        role source: Message [1..1];
        role target: communication.people.Person [0..*];
    }
    relation MessageCc {
        role source: Message [1..1];
        role target: communication.people.Person [0..*];
    }
    relation MessageBcc {
        role source: Message [1..1];
        role target: communication.people.Person [0..*];
    }
    relation MessageAddresses {
        role source: Message [1..1];
        role target: communication.people.Address [0..*];
    }
    relation MessageThread {
        role source: Message [1..1];
        role target: communication.threads.Thread [0..*];
    }
    relation MessageContent {
        role source: Message [1..1];
        role target: communication.content.Content [0..*];
    }
    relation MessageSignature {
        role source: Message [1..1];
        role target: communication.content.Signature [0..*];
    }
    relation MessageAttachments {
        role source: Message [1..1];
        role target: documents.attachments.Attachment [0..*];
    }
    relation MessageInReplyTo {
        role source: Message [1..1];
        role target: Message [0..*];
    }
    access Message {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access MessageSender {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access MessageTo {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access MessageCc {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
