{
  "id": "utils",
  "version": "1.0.0",
  "capabilities": [
    {
      "id": "utils.algorithm.email",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "algorithm",
      "targets": [
        "pipeline"
      ],
      "step_type": "algorithm",
      "name": "Email participants and chronology",
      "description": "Extract sender, recipients, Message-ID, thread identity and message time as tenant-isolated observations for ESKG.",
      "parameters_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "utils.algorithm.compose_reply",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "algorithm",
      "targets": [
        "pipeline"
      ],
      "step_type": "algorithm",
      "name": "Compose email reply",
      "description": "Prepare a durable reply from a template with message variables or through Scribe. Sending remains a separate action with mailbox approval and live permission checks.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "generation": {
            "type": "string",
            "title": "Generation method",
            "enum": [
              "template",
              "scribe"
            ],
            "default": "template"
          },
          "template": {
            "type": "string",
            "title": "Reply template",
            "description": "Variables: {{ sender }}, {{ recipient }}, {{ subject }}, {{ body }}, {{ date }}.",
            "default": "Hello {{ sender }},\n\nThank you for your message about {{ subject }}.",
            "format": "multiline"
          },
          "model_alias": {
            "type": "string",
            "title": "Scribe model alias",
            "format": "model-alias"
          },
          "instructions": {
            "type": "string",
            "title": "Instructions for Scribe",
            "default": "Write a helpful, accurate reply. Do not invent facts or commitments.",
            "format": "multiline"
          }
        },
        "required": [
          "generation"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "utils.output.reply",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "output",
      "targets": [
        "pipeline"
      ],
      "step_type": "sink",
      "name": "Send email reply",
      "description": "Reply from the selected SMTP account after the upstream filters and composition. Deployment activates this behavior; no separate automation profile is required.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "sender_account_id": {
            "type": "string",
            "title": "Send from",
            "format": "email-sender-account",
            "default": "source",
            "description": "The receiving account or another connected SMTP account you can use."
          },
          "delivery_mode": {
            "type": "string",
            "title": "Delivery",
            "enum": [
              "automatic",
              "approval",
              "draft"
            ],
            "default": "automatic",
            "description": "Automatic sends matching replies. Approval prepares a reply for review."
          }
        },
        "additionalProperties": false,
        "required": [
          "sender_account_id",
          "delivery_mode"
        ]
      }
    },
    {
      "id": "utils.input.email",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "input",
      "targets": [
        "pipeline"
      ],
      "step_type": "source",
      "name": "Read incoming emails",
      "description": "Collect authorized email accounts and attachments. Credentials are managed separately in Email settings.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "default": "email",
            "title": "Email collection group"
          },
          "parser": {
            "type": "string",
            "const": "json",
            "default": "json",
            "title": "Content parser",
            "x-advanced": true
          },
          "source_kind": {
            "type": "string",
            "const": "email",
            "default": "email",
            "title": "Source kind",
            "x-advanced": true
          },
          "match_pattern": {
            "type": "string",
            "default": "email-[a-f0-9]+-[a-f0-9]+\\.json$",
            "title": "Email object name pattern",
            "x-advanced": true
          },
          "schema_path": {
            "type": "string",
            "const": "schemas/avro/email.avsc",
            "default": "schemas/avro/email.avsc",
            "title": "Email record schema",
            "x-advanced": true
          },
          "topic": {
            "type": "string",
            "default": "raw",
            "title": "Event topic",
            "x-advanced": true
          },
          "content_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "application/json"
            ],
            "title": "Accepted content types",
            "x-advanced": true
          },
          "account_id": {
            "type": "string",
            "title": "Watch mailbox",
            "format": "email-source-account",
            "description": "New mail from this IMAP account triggers the deployed pipeline. Document indexing is independent."
          }
        },
        "required": [
          "parser",
          "source_kind",
          "schema_path",
          "account_id"
        ]
      }
    },
    {
      "id": "utils.mcp.email",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "mcp",
      "targets": [
        "scribe"
      ],
      "name": "Email tools",
      "description": "Read authorized mail, search collected messages and prepare drafts. Sending and credential management require separate human permissions.",
      "parameters_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "utils.skill.email",
      "plugin_id": "utils",
      "plugin_version": "1.0.0",
      "kind": "skill",
      "targets": [
        "scribe"
      ],
      "name": "Email correspondence",
      "compatibility": {
        "requires": [
          "utils.mcp.email"
        ]
      },
      "description": "Summarize conversations and compose grounded replies with explicit commitments and review.",
      "parameters_schema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "bindings": {
    "utils.algorithm.email": {
      "pipeline": "galadril_plugins.utils.pipeline.email_participants"
    },
    "utils.input.email": {
      "service": "email"
    },
    "utils.mcp.email": {
      "scribe": "galadril_plugins.utils.tools.tools"
    },
    "utils.skill.email": {
      "skill": "email.md"
    },
    "utils.output.reply": {
      "pipeline": "galadril_plugins.utils.pipeline.email_reply"
    },
    "utils.algorithm.compose_reply": {
      "pipeline": "galadril_plugins.utils.pipeline.compose_email_reply"
    }
  },
  "services": {
    "email": "galadril_plugins.utils.service.Worker",
    "tracker": {
      "runtime": "native",
      "command": [
        "/tracker"
      ]
    }
  },
  "ontologies": [
    "mail-ontology.json"
  ]
}
