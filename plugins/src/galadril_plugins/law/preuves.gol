            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access FilingExhibits {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access PleaExhibits {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access FilingDocument {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
