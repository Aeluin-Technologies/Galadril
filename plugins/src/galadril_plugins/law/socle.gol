// Authored GOL contract; security identities remain external.

ontology law.socle version "0.4.0" {
    security label LegalData {
        classification: Restricted;
        compartments: [Legal];
    }
    entity Case {
        field title: String @label(LegalData);
        field reference: Option<String> @label(LegalData);
    }
    enum ProceedingDegree { premier_degre, second_degre, hors_degre }
    enum ProceedingStatus { a_introduire, en_cours, terminee }
    entity Proceeding {
        field number: Option<String> @label(LegalData);
        field procedure: Option<String> @label(LegalData);
        field degree: Option<ProceedingDegree> @label(LegalData);
        field status: Option<ProceedingStatus> @label(LegalData);
    }
    entity Court {
        field name: String @label(LegalData);
        field postal_address: String @label(LegalData);
        field degree: Option<String> @label(LegalData);
    }
    enum PartyRepresentation { soi_meme, avocat, mandataire, representant_legal }
    entity Party {
        field name: String @label(LegalData);
        field public_postal_address: String @label(LegalData);
        field representation: PartyRepresentation @label(LegalData);
    }
    enum JudicialDecisionKind { jugement, arret, ordonnance, avis }
    entity JudicialDecision {
        field number: Option<String> @label(LegalData);
        field date: Option<String> @label(LegalData);
        field kind: Option<JudicialDecisionKind> @label(LegalData);
        field procedure: Option<String> @label(LegalData);
        field disposition: Option<String> @label(LegalData);
        field url: Option<String> @label(LegalData);
    }
    entity Provision {
        field reference: String @label(LegalData);
        field url: Option<String> @label(LegalData);
    }
    relation CaseProceedings {
        role source: Case [1..1];
        role target: Proceeding [0..*];
    }
    relation ProceedingCourt {
        role source: Proceeding [1..1];
        role target: Court [0..*];
    }
    relation ProceedingClaimants {
        role source: Proceeding [1..1];
        role target: Party [0..*];
    }
    relation ProceedingDefendants {
        role source: Proceeding [1..1];
        role target: Party [0..*];
    }
    relation ProceedingObservers {
        role source: Proceeding [1..1];
        role target: Party [0..*];
    }
    relation PartyRepresentative {
        role source: Party [1..1];
        role target: Party [0..*];
    }
    relation CourtParent {
        role source: Court [1..1];
        role target: Court [0..*];
    }
    relation ProceedingDecisions {
        role source: Proceeding [1..1];
        role target: JudicialDecision [0..*];
    }
    relation JudicialDecisionCourt {
        role source: JudicialDecision [1..1];
        role target: Court [0..*];
    }
    relation ProceedingAppeals {
        role source: Proceeding [1..1];
        role target: Proceeding [0..*];
    }
    relation ProceedingRelated {
        role source: Proceeding [1..1];
        role target: Proceeding [0..*];
    }
    access Case {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
