// Authored GOL contract; security identities remain external.

ontology law.administratif version "0.5.0" {
    import law.contentieux version "0.5.0" as LawContentieux;
    import law.preuves version "0.5.0" as LawPreuves;
    import law.socle version "0.5.0" as LawSocle;
    security label LegalData {
        classification: Restricted;
        compartments: [Legal];
    }
    entity Proceeding {
        field number: Option<String> @label(LegalData);
        field procedure: Option<String> @label(LegalData);
        field degree: Option<law.socle.ProceedingDegree> @label(LegalData);
        field status: Option<law.socle.ProceedingStatus> @label(LegalData);
    }
    enum CourtKind { tribunal_administratif, cour_administrative_appel, conseil_etat }
    entity Court {
        field name: String @label(LegalData);
        field postal_address: String @label(LegalData);
        field degree: Option<String> @label(LegalData);
        field kind: CourtKind @label(LegalData);
    }
    relation ProceedingCourt {
        role source: Proceeding [1..1];
        role target: Court [0..*];
    }
    entity AdministrativeAct {
        field title: String @label(LegalData);
        field date: Option<String> @label(LegalData);
    }
    relation ProceedingChallengedActs {
        role source: law.socle.Proceeding [1..1];
        role target: AdministrativeAct [0..*];
    }
    relation AdministrativeActAuthor {
        role source: AdministrativeAct [1..1];
        role target: law.socle.Party [0..*];
    }
    relation AdministrativeActDocument {
        role source: AdministrativeAct [1..1];
        role target: law.preuves.Document [0..*];
    }
    access Proceeding {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access Court {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access CourtKind {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access ProceedingCourt {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access AdministrativeAct {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access ProceedingChallengedActs {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access AdministrativeActAuthor {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
            relation: "transfer";
            cedar: "Gol::Action::\"transfer\"";
        }
        permission execute {
            relation: "execute";
            cedar: "Gol::Action::\"execute\"";
        }
    }
    access AdministrativeActDocument {
        resource: "gol_resource";
        permission read_access {
            relation: "read";
            cedar: "Gol::Action::\"read\"";
        }
        permission write_access {
            relation: "write";
            cedar: "Gol::Action::\"write\"";
        }
        permission describe {
            relation: "describe";
            cedar: "Gol::Action::\"describe\"";
        }
        permission transfer {
