{
  "namespace": "com.galadril.raw",
  "type": "record",
  "name": "Text",
  "doc": "Pure text data (Articles, Tweets, Transcripts).",
  "fields": [
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "ingested_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "storage_path",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Usually null for raw text"
    },
    {
      "name": "source",
      "type": "string"
    },
    {
      "name": "authz",
      "type": [
        "null",
        "com.galadril.auth.Authz"
      ],
      "default": null
    },
    {
      "name": "observation",
      "type": ["null", "com.galadril.observation.ObservationContext"],
      "default": null,
      "doc": "Shared evidence, lineage, input classification, and uncertainty context."
    },
    {
      "name": "content",
      "type": "string",
      "doc": "The actual text/HTML payload"
    },
    {
      "name": "url",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "author",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "language",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "encoding",
      "type": ["null", "string"],
      "default": null
    }
  ]
}
