{
  "type": "record",
  "name": "Authz",
  "namespace": "com.galadril.auth",
  "doc": "Inline authorization context propagated end-to-end. Self-contained version.",
  "fields": [
    {
      "name": "tenant",
      "type": "string",
      "doc": "Tenant root object id, e.g. 'tenant:acme'."
    },
    {
      "name": "tuples",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "AuthzTuple",
          "doc": "A Zanzibar/SpiceDB-style relationship tuple expressed inline for end-to-end propagation.",
          "fields": [
            {
              "name": "resource",
              "type": "string",
              "doc": "Object id, e.g. 'raw:topic:id'."
            },
            {
              "name": "relation",
              "type": "string",
              "doc": "Relation name, e.g. 'viewer', 'owner', 'tenant'."
            },
            {
              "name": "subject",
              "type": "string",
              "doc": "Subject id, e.g. 'tenant:acme', 'user:alice', 'group:analysts#member'."
            }
          ]
        }
      },
      "doc": "Inline Zanzibar/SpiceDB relationship tuples for this object."
    },
    {
      "name": "source_principal",
      "type": [
        "null",
        "string"
      ],
      "doc": "Who asserted this authz context.",
      "default": null
    }
  ]
}
