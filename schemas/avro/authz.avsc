{
  "type": "record",
  "name": "Authz",
  "namespace": "com.galadril.auth",
  "doc": "Trusted authorization context established by Intake; user payload metadata cannot override it.",
  "fields": [
    {
      "name": "tenant",
      "type": "string",
      "doc": "Tenant root object id, e.g. 'tenant:acme'."
    },
    {
      "name": "tuples",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "AuthzTuple",
          "doc": "A Zanzibar/SpiceDB-style relationship tuple expressed inline for end-to-end propagation.",
          "fields": [
            {
              "name": "resource",
              "type": "string",
              "doc": "Object id, e.g. 'raw:topic:id'."
            },
            {
              "name": "relation",
              "type": "string",
              "doc": "Relation name, e.g. 'viewer', 'owner', 'tenant'."
            },
            {
              "name": "subject",
              "type": "string",
              "doc": "Subject id, e.g. 'tenant:acme', 'user:alice', 'group:analysts#member'."
            }
          ]
        }
      },
      "doc": "Inline Zanzibar/SpiceDB relationship tuples for this object."
    },
    {
      "name": "source_principal",
      "type": [
        "null",
        "string"
      ],
      "doc": "Who asserted this authz context.",
      "default": null
    },
    {
      "name": "execution_identity",
      "type": "string",
      "doc": "Service principal executing the asynchronous step."
    },
    {
      "name": "initiating_actor",
      "type": "string",
      "doc": "Stable authenticated actor that initiated ingestion."
    },
    {
      "name": "authentication_provenance",
      "type": "string",
      "doc": "Trusted identity issuer that authenticated the initiating actor."
    },
    {
      "name": "delegation_id",
      "type": "string",
      "doc": "Stable identifier correlating the scoped delegation across services."
    },
    {
      "name": "requested_permission",
      "type": "string",
      "doc": "Canonical permission scoped to this workflow."
    },
    {
      "name": "requested_resource",
      "type": "string",
      "doc": "Tenant-qualified canonical resource reference."
    }
  ]
}
