load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_test(
    name = "composition_test",
    srcs = ["tests/composition.rs"],
    deps = [":registry"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_library(
    name = "registry",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "galadril_registry",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = ["//platform/ontology/rust:ontology"] + all_crate_deps(normal = True),
)

rust_test(
    name = "grpc_security_test",
    srcs = ["tests/grpc_security.rs", "tests/support/memory.rs"],
    crate_root = "tests/grpc_security.rs",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":registry"] + all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "gol_test",
    srcs = ["tests/gol.rs", "tests/support/memory.rs"],
    crate_root = "tests/gol.rs",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":registry", "//platform/ontology/rust:ontology"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "plugins_test",
    srcs = ["tests/plugins.rs", "tests/support/memory.rs"],
    crate_root = "tests/plugins.rs",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    compile_data = ["//plugins:ontology_packages", "//infrastructure/gol:configuration", "//schemas/spicedb:spicedb_contract"],
    deps = [":registry", "//platform/ontology/rust:ontology"] + all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "registry_test",
    crate = ":registry",
    compile_data = ["tests/grpc_status.rs"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "domain_test",
    srcs = ["tests/domain.rs"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":registry"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "semantics_test",
    srcs = ["tests/semantics.rs"],
    deps = [":registry"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
