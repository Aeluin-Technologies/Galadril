load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "document-compiler",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "galadril_document_compiler",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "security_test",
    srcs = ["tests/security.rs"],
    deps = [":document-compiler"] + all_crate_deps(normal = True),
)

rust_test(
    name = "archive_test",
    srcs = ["tests/archive.rs"],
    deps = [":document-compiler"] + all_crate_deps(normal = True),
)
