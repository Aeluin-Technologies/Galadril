load("@aspect_rules_py//py:defs.bzl", "py_image_layer", "py_layer_tier")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "galadril_vision",
    srcs = [
        "__init__.py",
        "main.py",
        "runtime.py",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//platform/vision/src/galadril_vision/common",
        "//platform/vision/src/galadril_vision/streaming",
        "//platform/vision/src/galadril_vision/telemetry",
        "@pip//faststream",
        "@pip//structlog",
        "@pip//uvloop",
    ],
)

py_binary(
    name = "vision",
    srcs = ["main.py"],
    data = ["@bazel_tools//tools/bash/runfiles"],
    imports = [".."],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        ":galadril_vision",
        "//platform/vision/src/galadril_vision/common",
        "//platform/vision/src/galadril_vision/streaming",
        "//platform/vision/src/galadril_vision/telemetry",
        "@pip//faststream",
        "@pip//structlog",
        "@pip//uvloop",
    ],
)

py_layer_tier(
    name = "vision_layer_tier",
    groups = {
        "@pip//botocore:botocore": "botocore",
        "@pip//confluent_kafka:confluent_kafka": "confluent_kafka",
        "@pip//cryptography:cryptography": "cryptography",
        "@pip//cvxpy:cvxpy": "cvxpy",
        "@pip//cython:cython": "cython",
        "@pip//fastavro:fastavro": "fastavro",
        "@pip//fonttools:fonttools": "fonttools",
        "@pip//grpcio:grpcio": "grpcio",
        "@pip//highspy:highspy": "highspy",
        "@pip//lightgbm:lightgbm": "lightgbm",
        "@pip//llvmlite:llvmlite": "llvmlite",
        "@pip//matplotlib:matplotlib": "matplotlib",
        "@pip//numba:numba": "numba",
        "@pip//numpy:numpy": "numpy",
        "@pip//opencv_python_headless:opencv_python_headless": "opencv_python_headless",
        "@pip//pandas:pandas": "pandas",
        "@pip//pillow:pillow": "pillow",
        "@pip//psycopg_binary:psycopg_binary": "psycopg_binary",
        "@pip//ray:ray": "ray",
        "@pip//scikit_learn:scikit_learn": "scikit_learn",
        "@pip//scipy:scipy": "scipy",
        "@pip//scs:scs": "scs",
        "@pip//sparsediffpy:sparsediffpy": "sparsediffpy",
        "@pip//sqlalchemy:sqlalchemy": "sqlalchemy",
        "@pip//statsmodels:statsmodels": "statsmodels",
        "@pip//sympy:sympy": "sympy",
        "@pip//uvloop:uvloop": "uvloop",
    },
)

py_image_layer(
    name = "vision_layers",
    binary = ":vision",
    layer_tier = ":vision_layer_tier",
)

pkg_tar(
    name = "mimalloc_layer",
    srcs = select({
        "@platforms//cpu:arm64": ["@mimalloc_linux_arm64//:so"],
        "@platforms//cpu:x86_64": ["@mimalloc_linux_amd64//:so"],
        "//conditions:default": ["@mimalloc_linux_amd64//:so"],
    }),
    package_dir = "/usr/lib",
)

oci_image(
    name = "linux",
    base = "@bristroless_python",
    entrypoint = ["/app"],
    env = {
        "LD_PRELOAD": "/usr/lib/libmimalloc.so",
        "PYTHONPATH": "/site-packages",
        "PYTHONWARNINGS": "ignore",
    },
    tars = [
        ":vision_layers",
        ":mimalloc_layer",
    ],
)

platform_transition_filegroup(
    name = "image_amd64",
    srcs = [":linux"],
    target_platform = "//:linux_amd64",
)

platform_transition_filegroup(
    name = "image_arm64",
    srcs = [":linux"],
    target_platform = "//:linux_arm64",
)

oci_load(
    name = "load",
    image = select({
        "@platforms//cpu:arm64": ":image_arm64",
        "@platforms//cpu:x86_64": ":image_amd64",
        "//conditions:default": ":image_amd64",
    }),
    repo_tags = ["galadril-vision:local"],
)

oci_image_index(
    name = "images",
    images = [
        ":image_amd64",
        ":image_arm64",
    ],
)

oci_push(
    name = "push",
    image = ":images",
    remote_tags = "//:stamped_tags",
    repository = "ghcr.io/aeluin-technologies/galadril-vision",
    visibility = ["//visibility:public"],
)
