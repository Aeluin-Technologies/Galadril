load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//platform/vision/tests:__pkg__"])

py_test(
    name = "test_ontology_runtime",
    srcs = ["test_ontology_runtime.py"],
    legacy_create_init = False,
    deps = [
        "//platform/ontology/src/galadril_ontology",
        "//platform/pipeline/src/galadril_pipeline",
        "//platform/pipeline/src/galadril_pipeline/config",
        "//platform/vision/src/galadril_vision/actors",
        "//platform/vision/src/galadril_vision/common",
        "@pip//anyio",  # keep: pytest plugin loaded at runtime
        "@pip//pytest",
    ],
)

py_test(
    name = "test_registry_runtime",
    srcs = ["test_registry_runtime.py"],
    legacy_create_init = False,
    deps = [
        "//platform/registry/python/galadril_registry_api",
        "//platform/vision/src/galadril_vision/connectors/version",
        "@pip//cloudpickle",
        "@pip//pytest",
    ],
)
