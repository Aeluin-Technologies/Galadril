py_test(
    name = "test_licorne",
    srcs = ["test_licorne.py"],
    legacy_create_init = False,
    deps = [
        "@pip//licorne",  # keep: native integration cases exercise the real wheel

        "//platform/ontology/src/galadril_ontology",
