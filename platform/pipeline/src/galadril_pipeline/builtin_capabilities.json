{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "core.input.kafka",
      "plugin_id": "core",
      "plugin_version": "1.0.0",
      "kind": "input",
      "targets": [
        "pipeline"
      ],
      "name": "Kafka source",
      "description": "Consume canonical records through a configured Kafka topic.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "default": "raw"
          },
          "match_pattern": {
            "type": "string"
          },
          "schema_path": {
            "type": "string"
          }
        },
        "required": [
          "match_pattern",
          "schema_path"
        ]
      },
      "step_type": "source",
      "model_class": null
    },
    {
      "id": "core.output.eskg",
      "plugin_id": "core",
      "plugin_version": "1.0.0",
      "kind": "output",
      "targets": [
        "pipeline"
      ],
      "name": "ESKG persistence",
      "description": "Persist events, entity state, vectors and authorization outbox in one transaction.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "modality": {
            "type": "string"
          },
          "edge_type": {
            "type": "string"
          },
          "state_type": {
            "type": "string"
          },
          "ontology_resource_id": {
            "type": "string"
          },
          "event_ontology_resource_id": {
            "type": "string"
          }
        }
      },
      "step_type": "sink",
      "model_class": null
    },
    {
      "id": "core.algorithm.resolve",
      "plugin_id": "core",
      "plugin_version": "1.0.0",
      "kind": "algorithm",
      "targets": [
        "pipeline"
      ],
      "name": "Entity resolution",
      "description": "Resolve inference observations using vector candidates and tenant-isolated identity allocation.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "modality": {
            "type": "string"
          },
          "threshold": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "candidate_top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      },
      "step_type": "resolve",
      "model_class": null
    },
    {
      "id": "core.algorithm.causal",
      "plugin_id": "core",
      "plugin_version": "1.0.0",
      "kind": "algorithm",
      "targets": [
        "pipeline"
      ],
      "name": "Causal analysis",
      "description": "Analyze a configured ESKG slice with Amarth.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "amarth_target_outcome": {
            "type": "string"
          },
          "amarth_window_size": {
            "type": "string",
            "default": "14D"
          }
        },
        "required": [
          "amarth_target_outcome"
        ]
      },
      "step_type": "causal",
      "model_class": null
    },
    {
      "id": "core.model.whisper",
