# gazelle:ignore

load("@rules_python//python:defs.bzl", "py_library")
load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_image_layer")
load("@rules_oci//oci:defs.bzl", "oci_image")

filegroup(name = "retrieval_data", srcs = ["retrieval.json", "retrieval_phrases.json", "retrieval_chunking.json", "retrieval_official.json", "hotpotqa.json", "retail.csv"], visibility = ["//tests/e2e:__pkg__"])

py_binary(
    name = "scribe_server",
    srcs = ["e2e_scribe.py"],
    main = "e2e_scribe.py",
    deps = ["//tests/e2e:retrieval_benchmark", "//machine-learning/scribe/python/galadril_scribe", "@pip//httpx", "@pip//uvloop"],
)
py_image_layer(name = "scribe_layers", binary = ":scribe_server", layer_tier = "//machine-learning/scribe/python/galadril_scribe:server_layer_tier")
oci_image(name = "scribe_linux", base = "@bristroless_python",entrypoint = ["/app"],env = {"PYTHONPATH":"/site-packages"},tars = [":scribe_layers"],visibility = ["//tests/e2e:__pkg__"])

py_library(
    name = "chat_model",
    srcs = ["e2e_chat_model.py"],
    imports = ["."],
    visibility = ["//tests/e2e:__pkg__"],
    deps = [
        "@pip//fastapi",
        "@pip//pydantic",
        "@pip//uvicorn",
    ],
)

py_binary(
    name = "chat_server",
    srcs = ["e2e_chat_model.py"],
    main = "e2e_chat_model.py",
    deps = [":chat_model"],
)

py_image_layer(
    name = "chat_layers",
    binary = ":chat_server",
)

oci_image(
    name = "chat_linux",
    base = "@bristroless_python",
    entrypoint = ["/app"],
    env = {"PYTHONPATH": "/site-packages"},
    tars = [":chat_layers"],
    visibility = ["//tests/e2e:__pkg__"],
)

filegroup(
    name = "fixtures",
    srcs = [
        "connectors.yaml",
        "e2e_inference_model.py",
        "otel-collector.yaml",
    ],
    visibility = ["//tests/e2e:__pkg__"],
)

filegroup(
    name = "empirical_data",
    srcs = [
        "retail.csv",
        "trial.csv",
    ],
    visibility = ["//tests/e2e:__pkg__"],
)
