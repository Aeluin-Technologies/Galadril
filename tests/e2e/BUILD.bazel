py_test(
    name = "pipeline_lifecycle_test",
    size = "enormous",
    timeout = "eternal",
    srcs = ["test_pipeline_lifecycle.py"],
    data = [
        "environment/compose.yaml",
        "//infrastructure/envoy:configuration",
        ":load_gateway",
        ":load_intake",
        ":load_registry",
        ":load_vision",
        ":load_scribe",
        ":load_chat_model",
        "//database:database_initialization",
        "//infrastructure/docker:database_initialization",
        "//infrastructure/docker:compose_configuration",
        "//schemas:avro_schema",
        "//schemas/spicedb:spicedb_contract",
        "//tests/e2e/fixtures",
    ],
    exec_properties = DOCKER_E2E_TEST_EXEC_PROPERTIES,
    legacy_create_init = False,
    main = "test_pipeline_lifecycle.py",
    tags = [
        "integration",
        "no-sandbox",
        "requires-docker",
    ],
    deps = [
        ":e2e_support",
        ":empirical_lifecycle_support",
        ":chatbot_support",
        "@pip//pytest",
