bazel_dep(name = "aspect_rules_js", version = "3.1.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension(
    "@rules_nodejs//nodejs:extensions.bzl",
    "node",
)
node.toolchain(
    node_version = "26.5.1",
)
use_repo(
    node,
    "nodejs_toolchains",
)

register_toolchains(
    "@nodejs_toolchains//:all",
)

pnpm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "pnpm",
    dev_dependency = True,
)
pnpm.pnpm(
    pnpm_version = "11.6.0",
)
use_repo(
    pnpm,
    "pnpm",
)

npm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "npm",
)
npm.npm_translate_lock(
    name = "npm",
    generate_bzl_library_targets = True,
    npmrc = "//:.npmrc",
    pnpm_lock = "//front/dashboard:pnpm-lock.yaml",
)
use_repo(
    npm,
    "npm",
)
