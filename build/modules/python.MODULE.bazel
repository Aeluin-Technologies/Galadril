bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.0.2")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
use_repo(python, "python_3_13")

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(
    hub_name = "pip",
)
uv.project(
    default_build_dependencies = [
        "build",
        "cmake>=3.21",
        "scikit-build-core>=0.9.2",
        "setuptools",
    ],
    hub_name = "pip",
    lock = "//:uv.lock",
    pyproject = "//:build/uv-project.toml",
)

# Workspace packages are built from their first-party Bazel targets.
uv.override_package(
    name = "amarth",
    lock = "//:uv.lock",
    target = "//platform/amarth/src/amarth",
)
uv.override_package(
    name = "eru",
    lock = "//:uv.lock",
    target = "//machine-learning/eru/src/eru",
)
uv.override_package(
    name = "galadril-inference",
    lock = "//:uv.lock",
    target = "//machine-learning/galadril-inference/src/galadril_inference",
)
uv.override_package(
    name = "galadril-ontology",
    lock = "//:uv.lock",
    target = "//platform/ontology/src/galadril_ontology",
)
uv.override_package(
    name = "galadril-pipeline",
    lock = "//:uv.lock",
    target = "//platform/pipeline/src/galadril_pipeline",
)
uv.override_package(
    name = "vision",
    lock = "//:uv.lock",
    target = "//platform/vision/src/galadril_vision",
)

# Use the platform C++ driver because Bazel's Apple wrapper is reported as clang.
uv.override_package(
    name = "llama-cpp-python",
    env = {
        "CMAKE_ARGS": "-DGGML_CCACHE=OFF -DGGML_METAL=OFF -DGGML_CUDA=OFF",
        "CXX": "/usr/bin/c++",
    },
    lock = "//:uv.lock",
)
use_repo(uv, "pip")
