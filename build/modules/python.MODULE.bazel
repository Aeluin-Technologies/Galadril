# Bazel's Git sdist builder ignores uv's subdirectory and omits Maturin's binary.
# Patch those boundaries and supply Bazel's Rust toolchain to the wheel action.
# Pin Cargo to the executor's GCC because Bazel omits Rust's linker helpers.
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.0.2")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")
single_version_override(
    module_name = "aspect_rules_py",
    patches = ["//build/patches:uv-hub-project-namespace.patch"],
    patch_strip = 1,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
use_repo(python, "python_3_13")

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(
    hub_name = "pip",
)
uv.project(
    default_build_dependencies = [
        "build",
        "cmake>=3.21",
        "maturin>=1.9,<2",
        "scikit-build-core>=0.9.2",
        "setuptools",
    ],
    hub_name = "pip",
    lock = "//:uv.lock",
    pyproject = "//build:uv-project.toml",
)

# Workspace packages are built from their first-party Bazel targets.
uv.override_package(
    name = "galadril-document-memory",
    lock = "//:uv.lock",
    target = "//third_party/hipporag:official",
)
uv.override_package(
    name = "galadril-scribe",
    lock = "//:uv.lock",
    target = "//machine-learning/scribe/python/galadril_scribe",
)
uv.override_package(
    name = "amarth",
    lock = "//:uv.lock",
    target = "//platform/amarth/src/amarth",
)
uv.override_package(
    name = "eru",
    lock = "//:uv.lock",
    target = "//machine-learning/eru/src/eru",
)
uv.override_package(
    name = "galadril-inference",
    lock = "//:uv.lock",
    target = "//machine-learning/galadril-inference/src/galadril_inference",
)
uv.override_package(
    name = "galadril-ontology",
    lock = "//:uv.lock",
    target = "//platform/ontology/src/galadril_ontology",
)
uv.override_package(
    name = "galadril-pipeline",
    lock = "//:uv.lock",
    target = "//platform/pipeline/src/galadril_pipeline",
)
uv.override_package(
    name = "galadril-plugins",
    lock = "//:uv.lock",
    target = "//plugins:galadril_plugins",
)
uv.override_package(
    name = "galadril-registry-api",
    lock = "//:uv.lock",
    target = "//platform/registry/python/galadril_registry_api",
)
uv.override_package(
    name = "vision",
    lock = "//:uv.lock",
    target = "//platform/vision/src/galadril_vision",
)

uv.override_package(
    name = "licorne",
    lock = "//:uv.lock",
    env = {
        "AR": "/usr/bin/ar",
        "MATURIN_NO_INSTALL_RUST": "1",
        "PATH": "$(EXECROOT)/$(RUST_WHEEL_BIN_DIR):/bin:/usr/bin:/usr/local/bin",
        "RUSTC": "$(EXECROOT)/$(RUST_WHEEL_RUSTC)",
        "RUSTFLAGS": "-C linker=/usr/bin/gcc",
    },
    pre_build_patches = ["//build/patches:licorne-root-pyproject.patch"],
    toolchains = ["//build:rust_wheel_toolchain"],
)

uv.override_package(
    name = "maturin",
    lock = "//:uv.lock",
    post_install_patches = ["//build/patches:maturin-binary-path.patch"],
)

# Use the platform C++ driver because Bazel's Apple wrapper is reported as clang.
uv.override_package(
    name = "llama-cpp-python",
    env = {
        "CMAKE_ARGS": "-DGGML_CCACHE=OFF -DGGML_METAL=OFF -DGGML_CUDA=OFF",
        "CXX": "/usr/bin/c++",
    },
    lock = "//:uv.lock",
)
uv.declare_hub(hub_name = "hipporag_cpu")
# Shared wheels keep one import identity in the Scribe image.
uv.override_package(name = "filelock", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//filelock")
uv.override_package(name = "fsspec", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//fsspec")
uv.override_package(name = "jinja2", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//jinja2")
uv.override_package(name = "markupsafe", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//markupsafe")
uv.override_package(name = "mpmath", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//mpmath")
uv.override_package(name = "networkx", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//networkx")
uv.override_package(name = "setuptools", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//setuptools")
uv.override_package(name = "sympy", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//sympy")
uv.override_package(name = "typing-extensions", lock = "//third_party/hipporag/cpu:uv.lock", target = "@pip//typing_extensions")
uv.project(
    hub_name = "hipporag_cpu",
    lock = "//third_party/hipporag/cpu:uv.lock",
    pyproject = "//third_party/hipporag/cpu:pyproject.toml",
)
use_repo(uv, "pip", "hipporag_cpu")
