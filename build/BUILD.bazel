load(
    "@rules_shell//shell:sh_binary.bzl",
    "sh_binary",
)
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load(":rust_build_script_test.bzl", "amd64_build_script_test", "arm64_build_script_test", "build_script_tool_fixture")
load(":rust_wheel_toolchain.bzl", "rust_wheel_toolchain")

package(
    default_visibility = ["//visibility:public"],
)

genrule(
    name = "build_script_fixture_src",
    testonly = True,
    outs = ["build_script_fixture.rs"],
    cmd = "printf 'fn main() {}\\n' > $@",
)

cargo_build_script(
    name = "build_script_fixture",
    testonly = True,
    srcs = [":build_script_fixture_src"],
    edition = "2024",
    tags = ["manual"],
)

arm64_build_script_test(
    name = "arm64_build_script_test",
    target_under_test = ":build_script_fixture",
)

amd64_build_script_test(
    name = "amd64_build_script_test",
    target_under_test = ":build_script_fixture",
)

build_script_tool_fixture(
    name = "build_script_arm64_tool_fixture",
    testonly = True,
    exec_compatible_with = ["@platforms//cpu:arm64", "@platforms//os:linux"],
    tool = ":build_script_fixture",
)

build_script_tool_fixture(
    name = "build_script_amd64_tool_fixture",
    testonly = True,
    exec_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
    tool = ":build_script_fixture",
)

arm64_build_script_test(
    name = "arm64_build_script_tool_test",
    target_under_test = ":build_script_arm64_tool_fixture",
)

amd64_build_script_test(
    name = "amd64_build_script_tool_test",
    target_under_test = ":build_script_amd64_tool_fixture",
)

exports_files([
    "bazel_stamp.sh",
    "gazelle.bzl",
    "multirun.bzl",
    "node.bzl",
    "platforms.bzl",
    "python.bzl",
    "setup.bzl",
    "testing.bzl",
    "uv-project.toml",
    "version_test.sh",
    "version_to_tag.sh",
    "version_to_tags.sh",
])

rust_wheel_toolchain(
    name = "rust_wheel_toolchain_default",
)

# The ARM64 wheel action executes on ARM64, so Cargo and rustc must also be native.
rust_wheel_toolchain(
    name = "rust_wheel_toolchain_arm64",
    exec_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64_target",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "rust_wheel_toolchain",
    actual = select({
        ":linux_arm64_target": ":rust_wheel_toolchain_arm64",
        "//conditions:default": ":rust_wheel_toolchain_default",
    }),
)

# Licorne's source build needs crates.io on both image architectures.
platform(
    name = "rbe_network_linux_x86_64",
    exec_properties = {"network": "external"},
    parents = ["@toolchains_buildbuddy//platforms:linux_x86_64"],
)

platform(
    name = "rbe_network_linux_arm64",
    exec_properties = {"network": "external"},
    parents = ["@toolchains_buildbuddy//platforms:linux_arm64"],
)

sh_binary(
    name = "version_to_tag",
    srcs = ["version_to_tag.sh"],
)

sh_binary(
    name = "version_to_tags",
    srcs = ["version_to_tags.sh"],
)
